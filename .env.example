# Database (root .env, optional — server/index.js has hardcoded fallbacks)
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PORT=

# server/.env (dotenv loads from cwd which is /server, NOT the root)
# OpenAI (voice cockpit STT/LLM/TTS)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# Vasudev SMS gateway (OTP for CEO/RM/DM logins). Endpoint: portal.vasudevsms.in
SMS_API_KEY=
SMS_USER=
SMS_PASSWORD=
SMS_SENDER_ID=NVCHTN
